{
	auto_https off
	admin off
	servers {
		timeouts {
			read_body 60s
			read_header 10s
			write 0s
			idle 600s
		}
	}
}

:8080 {
	@authorized header Authorization "Bearer {$BEARER_TOKEN}"
	@queryauth query token={$BEARER_TOKEN}
	@oauth_discovery path /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource /register /oauth/register

	handle /health {
		respond "OK" 200
	}

	handle @oauth_discovery {
		respond "Not Found" 404
	}

	handle @authorized {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			transport http {
				read_timeout 600s
			}
		}
	}

	handle @queryauth {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			transport http {
				read_timeout 600s
			}
		}
	}

	handle {
		respond "Unauthorized" 401
	}
}
